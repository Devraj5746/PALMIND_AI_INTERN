# ---- Build stage: build a reproducable venv from lock-pinned sources ----

FROM python:3.13-slim AS builder

# No C toolchain here on purpose: every locked runtime dependency resolves to a
# prebuilt manylinux wheel for CPython 3.13, so no compiler is needed.  (If a
# dependency ever loses wheel coverage, this stage fails loudly at build time
# instead of silently needing gcc.)

# NOTE: the venv must be created at the *runtime* path (/app/.venv), not at the
# build path.  Console scripts (uvicorn, fastapi, ...) embed an absolute shebang
# pointing at the interpreter used to install them; building under /src and then
# copying to /app/.venv leaves every script executing `#!/src/.venv/bin/python`,
# which the kernel reports as "no such file or directory" (exit 255).
WORKDIR /app
COPY pyproject.toml README.md uv.lock ./
COPY app ./app
# `--seed` is deliberately omitted: pip/setuptools/virtualenv-vendored tooling
# are never used inside this image, they would only add weight to /app/.venv.
RUN --mount=type=cache,id=uv,target=/root/.cache/uv \
    pip install --no-cache-dir uv==0.9.1 && \
    uv venv /app/.venv --python 3.13 --quiet && \
    uv pip install --python /app/.venv/bin/python \
        -e ./ --quiet

# ---- Runtime image ----

FROM python:3.13-slim

# POSIX timezone so logs / scheduling are interpretable without a TZ var.
RUN ln -snf /usr/share/zoneinfo/UTC /etc/localtime && \
    echo "UTC" > /etc/timezone && \
    apt-get update -q && \
    apt-get install -y --no-install-recommends \
        ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*

ENV APP_ENV=production \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Copy only the built venv + app sources. Tests/docs are intentionally left out
# of the production image so they cannot be used to introspect internals.
COPY --from=builder /app/.venv /app/.venv
COPY app /app/app

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH=/app

# Fail the build (rather than every container start) if the interpreter the
# entry-point scripts point at, or the app package, is not importable here.
RUN /app/.venv/bin/python -c "import uvicorn, app.main"

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
  CMD curl -f http://localhost:8000/api/v1/health || exit 1

# Default process is the app itself; override at runtime with `docker run` if
# you need a shell (e.g. for debugging the venv).
CMD ["uvicorn", "app.main:app", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--no-access-log", "--log-level", "info"]
