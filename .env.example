# =============================================================================
# TechKraft RAG Backend - Environment Configuration
#
#   cp .env.example .env
#
# Every value below works as-is with `docker compose up` EXCEPT OPENAI_API_KEY.
# To run the whole stack with no API key at all (offline profile), set:
#   LLM_PROVIDER=mock
#   EMBEDDING_PROVIDER=hash
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development              # development | staging | production
DEBUG=true
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["*"]               # JSON array, or a comma-separated list

# -----------------------------------------------------------------------------
# LLM provider  (openai | mock)
#   * openai -> requires OPENAI_API_KEY
#   * mock   -> deterministic, offline provider used by the test-suite. It still
#               runs the full interview-booking flow via rule-based extraction,
#               but it has no world knowledge and only echoes retrieved context.
# NOTE: APP_ENV=production refuses LLM_PROVIDER=mock.
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-replace-me
# Leave OPENAI_BASE_URL empty to use api.openai.com; set it to use a proxy.
# NOTE: keep the comment on its own line — `docker compose` does not strip a
# trailing comment from a *blank* value and would pass the text through as the
# value (unlike python-dotenv, which strips it for local runs).
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=1024
LLM_REQUEST_TIMEOUT_SECONDS=60

# -----------------------------------------------------------------------------
# Embeddings  (openai | hash | sentence_transformers)
#   * openai                -> text-embedding-3-small (1536 dims); needs a key
#   * hash                  -> deterministic local hashing-trick embedder, zero
#                              network calls, used by CI. Lexical, not semantic.
#   * sentence_transformers -> local model; requires the optional extra:
#                              `make install-local-embeddings`
# NOTE: APP_ENV=production refuses EMBEDDING_PROVIDER=hash. Switching providers
# changes the vector size, so also change QDRANT_COLLECTION or re-ingest.
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=64
HASH_EMBEDDING_DIMENSION=384     # vector size for EMBEDDING_PROVIDER=hash
# Optional override for models not in the built-in (model -> dimension) table.
EMBEDDING_DIMENSION=

# -----------------------------------------------------------------------------
# Qdrant (vector store: chunk embeddings)
#   QDRANT_URL accepts http(s)://host:port, `:memory:` (ephemeral, tests only)
#   or `local:/path/to/dir` (on-disk, no server required).
# -----------------------------------------------------------------------------
QDRANT_URL=http://qdrant:6333     # http://localhost:6333 for local dev
QDRANT_API_KEY=
QDRANT_COLLECTION=documents
QDRANT_PREFER_GRPC=false

# -----------------------------------------------------------------------------
# Redis (multi-turn chat memory + in-progress booking drafts)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CHAT_MEMORY_TTL_SECONDS=86400     # session transcript lifetime (24h)
CHAT_MEMORY_MAX_MESSAGES=20       # sliding window kept per session

# -----------------------------------------------------------------------------
# Database (metadata: documents, chunks, bookings)
#   Any SQLAlchemy async URL works. SQLite is the zero-setup local default:
#   sqlite+aiosqlite:///./rag.db
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://rag:rag@postgres:5432/rag
DB_ECHO=false

# -----------------------------------------------------------------------------
# Ingestion
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=[".pdf",".txt"]
DEFAULT_CHUNKING_STRATEGY=recursive   # recursive | fixed
DEFAULT_CHUNK_SIZE=1000               # characters
DEFAULT_CHUNK_OVERLAP=150             # characters; must be < DEFAULT_CHUNK_SIZE

# -----------------------------------------------------------------------------
# Retrieval / RAG
# -----------------------------------------------------------------------------
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.2               # cosine similarity; 0 disables filtering
RAG_MAX_CONTEXT_CHARS=8000            # hard cap on the assembled context block
RAG_CONDENSE_FOLLOWUPS=true           # rewrite follow-ups into standalone queries
